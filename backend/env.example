# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: JWT Secret for token validation
JWT_SECRET_KEY=your_jwt_secret_key_here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# AI Configuration (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
AI_ENABLED=True
AI_MODEL=gpt-4o-mini
AI_CACHE_ENABLED=True

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_MINI_WEEKLY=price_your_mini_weekly_price_id
STRIPE_PRICE_PRO_LIFETIME=price_your_pro_lifetime_price_id
STRIPE_PRICE_PRO_MONTHLY=price_your_pro_monthly_price_id
STRIPE_PRICE_PRO_YEARLY=price_your_pro_yearly_price_id
STRIPE_PRICE_TEAM_MONTHLY=price_your_team_monthly_price_id
STRIPE_PRICE_PRO_TEST=price_your_pro_test_price_id  # TEST ONLY - Remove before production

# Payment Methods Note:
# - Credit/Debit Cards: Supported globally
# - Stripe Link: Available in US, UK, and other supported countries
# - UPI (India): NOT currently supported by Stripe due to regulatory limitations
#   Stripe has limited operations in India. Indian customers can use credit/debit cards only.

# Dodo Payments Configuration (Alternative to Stripe)
# IMPORTANT: Add your actual keys to backend/.env (NOT this file!)
# This file is just a template and may be committed to Git
DODO_API_KEY=your_dodo_api_key_here
DODO_API_URL=https://api.dodopayments.com/v1
DODO_WEBHOOK_SECRET=your_dodo_webhook_secret_here

# Frontend URL (for payment redirects)
FRONTEND_URL=http://localhost:3000
